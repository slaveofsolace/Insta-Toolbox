  const existing = new Set(state.queue
    .filter((item) => item.action === 'unfollow' && item.status !== 'removed')
    .map((item) => normalizeUsername(item.account.username)));
  let count = 0;
  for (const account of accounts) {
    if (existing.has(account.username)) continue;
    const protectionReason = getUnfollowProtectionReason(
      account,
      activeSnapshot(),
      state.settings,
    );
    state.queue.push(createQueueItem(account, 'unfollow', {
      reason: protectionReason || 'not-following-back-review',
      status: protectionReason ? 'protected' : 'ready',
      preexisting: protectionReason === 'preexisting-follow',
    }));
    existing.add(account.username);
    count += 1;
  }
  logActivity('queue', `Added ${count} account${count === 1 ? '' : 's'} to unfollow review.`);
}

app.addEventListener('click', async (event) => {
  const target = event.target.closest('[data-action]');
  if (!target) return;
  const action = target.dataset.action;

  if (action === 'navigate') {
    activeView = target.dataset.view;
    window.scrollTo(0, 0);
    render({ focusHeading: true });
    return;
  }
  if (action === 'relationship-tab') {
    relationshipTab = target.dataset.tab;
    render({
      focusSelector: `[data-action="relationship-tab"][data-tab="${relationshipTab}"]`,
    });
    return;
  }
  if (action === 'pick-data-files') {
    document.querySelector('#data-file-input').click();
    return;
  }
  if (action === 'pick-data-folder') {
    document.querySelector('#data-folder-input').click();
    return;
  }
  if (action === 'pick-zip-file') {
    document.querySelector('#zip-file-input').click();
    return;
  }
  if (action === 'confirm-zip-import') {
    await handleZipImport();
    return;
  }
  if (action === 'cancel-zip-import') {
    if (zipImportController) {
      zipImportController.abort();
    } else {
      pendingZip = null;
      zipImportStatus = { phase: 'idle', processed: 0, total: 0, message: '' };
      render();
    }
    return;
  }
  if (action === 'pick-state-file') {
    document.querySelector('#state-file-input').click();
    return;
  }
  if (action === 'clear-warnings') {
    state.importWarnings = [];
    await persist();
    return;
  }
  if (action === 'activate-snapshot') {
    state.activeSnapshotId = target.dataset.id;
    state.queue = refreshQueue(state.queue, activeSnapshot(), state.settings);
    await persist();
    return;
  }
  if (action === 'queue-account') {
    const account = { username: target.dataset.username, source: 'relationship-review' };
    if (target.dataset.queueAction === 'unfollow') addAccountsToUnfollowQueue([account]);
    else state.queue = addFollowTargets(state.queue, [account.username]);
    await persist();
    return;
  }
  if (action === 'queue-current-list') {
    addAccountsToUnfollowQueue(currentRelationshipAccounts());
    await persist();
    return;
  }
  if (action === 'export-current-list') {
    downloadText(`insta-aio-${relationshipTab}.csv`, accountsToCsv(currentRelationshipAccounts()), 'text/csv');
    logActivity('export', `Exported ${relationshipTab} CSV.`);
    await persist({ rerender: false });
    return;
  }
  if (action === 'add-follow-targets') {
    const value = document.querySelector('#follow-targets').value;
    const usernames = value.split(/[\n,\s]+/).map(normalizeUsername).filter(Boolean);
    const before = state.queue.length;
    state.queue = addFollowTargets(state.queue, usernames, { reason: 'manual-follow-target' });
    logActivity('queue', `Added ${state.queue.length - before} follow target${state.queue.length - before === 1 ? '' : 's'}.`);
    await persist();
    return;
  }
  if (action === 'refresh-queue') {
    state.queue = refreshQueue(state.queue, activeSnapshot(), state.settings);
    logActivity('queue', 'Refreshed queue scheduling and protections.');
    await persist();
    return;
  }
  if (action === 'toggle-queue-selection') {
    const selected = new Set(state.selectedQueueItemIds || []);
    if (target.checked) selected.add(target.dataset.id);
    else selected.delete(target.dataset.id);
    state.selectedQueueItemIds = [...selected];
    await persist();
    return;
  }
  if (action === 'select-actionable-queue') {
    state.selectedQueueItemIds = state.queue
      .filter((item) => (
        ['pending', 'ready', 'paused', 'failed'].includes(item.status)
        && item.migrationOnly !== true
      ))
      .map((item) => item.id);
    await persist();
    return;
  }
  if (action === 'clear-queue-selection') {
    state.selectedQueueItemIds = [];
    await persist();
    return;
  }
  if (action === 'create-action-preview') {
    if (!state.selectedQueueItemIds.length) {
      window.alert('Select at least one actionable queue record first.');
      return;
    }
    const job = createReviewedActionJob(state.queue, {
      snapshot: activeSnapshot(),
      settings: state.settings,
      selectedIds: state.selectedQueueItemIds,
    });
    state.actionJobs = [job, ...(state.actionJobs || [])].slice(0, 100);
    logActivity(
      'action-preview',
      `Created a reviewed preview with ${job.items.length} actionable and ${job.blockedItems.length} blocked record${job.items.length + job.blockedItems.length === 1 ? '' : 's'}.`,
      { jobId: job.id, previewDigest: job.previewDigest },
    );
    await persist();
    return;
  }
  if (action === 'confirm-action-dry-run') {
    const job = state.actionJobs?.[0];
    if (!job) return;
    try {
      const confirmed = confirmReviewedActionJob(job, {
        phrase: job.confirmationPhrase,
        mode: 'dry-run',
        settings: state.settings,
      });
      state.actionJobs[0] = confirmed;
      logActivity(
        'action-confirmation',
        `Prepared reviewed no-click batch containing ${confirmed.items.length} item${confirmed.items.length === 1 ? '' : 's'}.`,
        { jobId: confirmed.id, previewDigest: confirmed.previewDigest },
      );
      await persist();
    } catch (error) {
      window.alert(error.message);
    }
    return;
  }
  if (action === 'run-action-extension-dry-run') {
    const job = state.actionJobs?.[0];
    if (!job || job.mode !== 'dry-run' || job.status !== 'ready') return;
    if (actionExecutionController) {
      bridgeStatus = 'A reviewed account execution is already in progress.';
      render();
      return;
    }
    const controller = new AbortController();
    actionExecutionController = controller;
    actionExecutionJobId = job.id;
    bridgeStatus = 'Inspecting the active Instagram profile without clicking...';
    render();
    try {
      const response = await requestExtensionBridge(
        state.bridgePairing,
        'action.account-job',
        { job },
        { timeoutMs: 15_000 },
      );
      assertCurrentActionExecution(controller, job);
      if (response.type === 'action.bridge-error') {
        throw new Error(response.payload?.reason || 'extension-rejected-job');
      }
      state.actionJobs[0] = applyAccountBridgeResult(job, response.payload);
      bridgeStatus = response.payload?.status === 'dry-run-complete'
        ? 'Extension dry run completed without clicking.'
        : `Extension dry run stopped safely: ${response.payload?.stopReason || 'unknown reason'}.`;
      logActivity('extension-dry-run', bridgeStatus, {
        jobId: job.id,
        stopReason: response.payload?.stopReason || null,
      });
      await persist();
    } catch (error) {
      bridgeStatus = controller.signal.aborted
        ? 'Account dry run canceled because its reviewed job was discarded.'
        : `Error: ${error.message}`;
      render();
    } finally {
      if (actionExecutionController === controller) {
        actionExecutionController = null;
        actionExecutionJobId = null;
      }
    }
    return;
  }
  if (action === 'run-action-extension-live') {
    let job = state.actionJobs?.[0];
    const canPrepare = job?.status === 'awaiting-confirmation' && job.items.length === 1;
    const alreadyPrepared = job?.mode === 'live' && job.status === 'ready' && job.items.length === 1;
    if (!canPrepare && !alreadyPrepared) return;
    if (actionExecutionController) {
      bridgeStatus = 'A reviewed account execution is already in progress.';
      render();
      return;
    }
    let item = job.items[0];
    const actionLabel = item.action === 'follow' ? 'Follow' : 'Unfollow';
    const reviewedJob = {
      id: job.id,
      previewDigest: job.previewDigest,
      status: job.status,
      itemId: item.id,
      action: item.action,
      username: item.username,
    };
    const confirmed = await confirmAction({
      title: `${actionLabel} 1 account?`,
      message: 'The extension will re-check this exact profile before it acts.',
      facts: [
        { label: 'Target', value: `@${item.username}` },
        { label: 'Action', value: actionLabel },
        { label: 'Count', value: '1 account' },
      ],
      confirmLabel: `${actionLabel} @${item.username}`,
    });
    if (!confirmed) {
      bridgeStatus = `${actionLabel} canceled. Nothing changed.`;
      render({ focusSelector: '[data-action="run-action-extension-live"]' });
      return;
    }
    const currentJob = state.actionJobs?.[0];
    const currentItem = currentJob?.items?.[0];
    if (
      activeView !== 'queue'
      || currentJob?.id !== reviewedJob.id
      || currentJob?.previewDigest !== reviewedJob.previewDigest
      || currentJob?.status !== reviewedJob.status
      || currentJob?.items?.length !== 1
      || currentItem?.id !== reviewedJob.itemId
      || currentItem?.action !== reviewedJob.action
      || currentItem?.username !== reviewedJob.username
    ) {
      bridgeStatus = `${actionLabel} canceled because the reviewed target changed. Nothing changed.`;
      render();
      return;
    }
    job = currentJob;
    item = currentItem;
    if (canPrepare) {
      try {
        job = confirmReviewedActionJob(job, {
          phrase: job.confirmationPhrase,
          mode: 'live',
          settings: {
            ...state.settings,
            liveActionBatchLimit: 1,
            liveActionEnabled: true,
          },
        });
        state.actionJobs[0] = job;
        await persist({ rerender: false });
      } catch (error) {
        bridgeStatus = `Stopped: ${error.message}`;
        render();
        return;
      }
    }
    const confirmation = {
      confirmed: true,
      action: item.action,
      count: 1,
      username: item.username,
    };
    const controller = new AbortController();
    actionExecutionController = controller;
    actionExecutionJobId = job.id;
    bridgeStatus = 'Checking the signed one-item intent and exact Instagram profile...';
    render();
    try {
      const prepared = await requestExtensionBridge(
        state.bridgePairing,
        'action.account-live-intent',
        { job },
        { timeoutMs: 15_000 },
      );
      assertCurrentActionExecution(controller, job);
      if (prepared.type === 'action.bridge-error') {
        throw new Error(prepared.payload?.reason || 'extension-rejected-live-intent');
      }
      if (prepared.type !== 'action.account-live-intent-result') {
        throw new Error('The extension returned an unexpected live-intent response.');
      }
      if (prepared.payload?.ready !== true) throw new Error('The exact account intent was not accepted.');

      bridgeStatus = 'Revalidating the exact profile before the durable reservation...';
      render();
      const driver = createExtensionAccountActionDriver(state.bridgePairing, {
        confirmation,
        jobId: job.id,
      });
      const ledger = createIndexedDbActionLedger();
      const result = await executeReviewedActionJob(job, {
        driver,
        ledger,
        settings: state.settings,
        snapshot: activeSnapshot(),
        signal: controller.signal,
        async onCheckpoint(checkpointJob) {
          assertCurrentActionExecution(controller, job);
          const savedState = await saveActionJobCheckpoint(checkpointJob);
          assertCurrentActionExecution(controller, job);
          state = savedState;
          render();
        },
      });
      assertCurrentActionExecution(controller, job);
      for (const item of result.items.filter((candidate) => candidate.status === 'completed')) {
        state.queue = markQueueItem(state.queue, item.queueItemId, 'completed');
      }
      bridgeStatus = result.status === 'completed'
        ? `Controlled live action completed. The job checkpoint and ledger result are durable.`
        : `Controlled live action stopped safely: ${result.stopReason || 'unknown reason'}.`;
      await persist();
    } catch (error) {
      bridgeStatus = controller.signal.aborted
        ? 'Reviewed action discarded. No new action will be dispatched; check the durable ledger before retrying because an action already in flight cannot be recalled.'
        : `Stopped: ${error.message}`;
      render();
    } finally {
      if (actionExecutionController === controller) {
        actionExecutionController = null;
        actionExecutionJobId = null;
      }
    }
    return;
  }
  if (action === 'export-reviewed-action-job') {
    const job = state.actionJobs?.[0];
    if (!job?.confirmedAt) return;
    downloadJson(`insta-aio-reviewed-action-job-${Date.now()}.json`, job);
    logActivity('export', `Exported reviewed ${job.mode} action job.`, {
      jobId: job.id,
      previewDigest: job.previewDigest,
    });
    await persist({ rerender: false });
    return;
  }
  if (action === 'discard-action-job') {
    const [discarded, ...remaining] = state.actionJobs || [];
    if (discarded?.id === actionExecutionJobId) actionExecutionController?.abort();
    state.actionJobs = remaining;
    if (discarded) {
      logActivity('action-preview', 'Discarded a reviewed action preview.', {
        jobId: discarded.id,
      });
    }
    await persist();
    return;
  }
  if (action === 'queue-status') {
    state.queue = markQueueItem(state.queue, target.dataset.id, target.dataset.status);
    state.queue = refreshQueue(state.queue, activeSnapshot(), state.settings);
    logActivity('queue', `Marked queue item ${target.dataset.status}.`, { id: target.dataset.id });
    await persist();
    return;
  }
  if (action === 'create-dm-preview') {
    if (!state.selectedMessageIds.length) {
      window.alert('Select at least one sent message first.');
      return;
    }
    const job = createReviewedDmJob(state.messages, state.selectedMessageIds);
    state.dmJobs = [job, ...(state.dmJobs || [])].slice(0, 100);
    logActivity(
      'dm-preview',
      `Created a reviewed DM preview with ${job.items.length} eligible and ${job.blockedItems.length} blocked message${job.items.length + job.blockedItems.length === 1 ? '' : 's'}.`,
      { jobId: job.id, previewDigest: job.previewDigest },
    );
    await persist();
    return;
  }
  if (action === 'confirm-dm-dry-run') {
    const job = state.dmJobs?.[0];
    if (!job) return;
    try {
      const reviewed = confirmDmJobReview(job, {
        phrase: job.reviewConfirmationPhrase,
        mode: 'dry-run',
        settings: state.settings,
      });
      state.dmJobs[0] = reviewed;
      logActivity(
        'dm-confirmation',
        `Prepared reviewed no-click DM batch containing ${reviewed.items.length} sent message${reviewed.items.length === 1 ? '' : 's'}.`,
        { jobId: reviewed.id, previewDigest: reviewed.previewDigest },
      );
      await persist();
    } catch (error) {
      window.alert(error.message);
    }
    return;
  }
  if (action === 'run-dm-extension-dry-run') {
    const job = state.dmJobs?.[0];
    if (!job || job.mode !== 'dry-run' || job.status !== 'ready') return;
    if (dmExecutionController) {
      bridgeStatus = 'A reviewed DM execution is already in progress.';
      render();
      return;
    }
    const controller = new AbortController();
    dmExecutionController = controller;
    dmExecutionJobId = job.id;
    bridgeStatus = 'Checking exact-message resolution support without clicking...';
    render();
    try {
      const response = await requestExtensionBridge(
        state.bridgePairing,
        'action.dm-job',
        { job },
        { timeoutMs: 15_000 },
      );
      assertCurrentDmExecution(controller, job);
      if (response.type === 'action.bridge-error') {
        throw new Error(response.payload?.reason || 'extension-rejected-job');
      }
      state.dmJobs[0] = applyDmBridgeResult(job, response.payload);
      bridgeStatus = response.payload?.status === 'dry-run-complete'
        ? 'Extension DM dry run completed without clicking.'
        : `Extension DM dry run stopped safely: ${response.payload?.stopReason || 'unknown reason'}.`;
      logActivity('extension-dry-run', bridgeStatus, {
        jobId: job.id,
        stopReason: response.payload?.stopReason || null,
      });
      await persist();
    } catch (error) {
      bridgeStatus = controller.signal.aborted
        ? 'DM dry run canceled because its reviewed job was discarded.'
        : `Error: ${error.message}`;
      render();
    } finally {
      if (dmExecutionController === controller) {
        dmExecutionController = null;
        dmExecutionJobId = null;
      }
    }
    return;
  }
  if (action === 'run-dm-extension-live') {
    let job = state.dmJobs?.[0];
    const canReview = job?.status === 'awaiting-review-confirmation' && job.items.length === 1;
    const canFinalize = job?.status === 'awaiting-destructive-confirmation' && job.items.length === 1;
    const alreadyPrepared = job?.mode === 'live' && job.status === 'ready' && job.items.length === 1;
    if (!canReview && !canFinalize && !alreadyPrepared) return;
    if (dmExecutionController) {
      bridgeStatus = 'A reviewed DM execution is already in progress.';
      render();
      return;
    }
    let item = job.items[0];
    const conversationLabel = item.conversationName || item.conversationId;
    const reviewedJob = {
      id: job.id,
      previewDigest: job.previewDigest,
      status: job.status,
      itemId: item.id,
      conversationId: item.conversationId,
      messageId: item.messageId,
    };
    const confirmed = await confirmAction({
      title: 'Unsend 1 DM?',
      message: 'The extension will re-check this exact thread and sent message before it acts.',
      facts: [
        { label: 'Thread', value: conversationLabel },
        { label: 'Message', value: item.messageId },
        { label: 'Action', value: 'Unsend' },
      ],
      confirmLabel: 'Unsend this DM',
    });
    if (!confirmed) {
      bridgeStatus = 'DM Unsend canceled. Nothing changed.';
      render({ focusSelector: '[data-action="run-dm-extension-live"]' });
      return;
    }
    const currentJob = state.dmJobs?.[0];
    const currentItem = currentJob?.items?.[0];
    if (
      activeView !== 'messages'
      || currentJob?.id !== reviewedJob.id
      || currentJob?.previewDigest !== reviewedJob.previewDigest
      || currentJob?.status !== reviewedJob.status
      || currentJob?.items?.length !== 1
      || currentItem?.id !== reviewedJob.itemId
      || currentItem?.conversationId !== reviewedJob.conversationId
      || currentItem?.messageId !== reviewedJob.messageId
    ) {
      bridgeStatus = 'DM Unsend canceled because the reviewed message changed. Nothing changed.';
      render();
      return;
    }
    job = currentJob;
    item = currentItem;
    try {
      if (canReview) {
        job = confirmDmJobReview(job, {
          phrase: job.reviewConfirmationPhrase,
          mode: 'live',
          settings: {
            ...state.settings,
            liveDmBatchLimit: 1,
            liveDmUnsendEnabled: true,
          },
        });
      }
      if (job.status === 'awaiting-destructive-confirmation') {
        job = confirmDmJobDestructive(job, {
          phrase: job.destructiveConfirmationPhrase,
        });
      }
      state.dmJobs[0] = job;
      await persist({ rerender: false });
    } catch (error) {
      bridgeStatus = `Stopped: ${error.message}`;
      render();
      return;
    }
    const confirmation = {
      confirmed: true,
      action: 'unsend',
      conversationId: item.conversationId,
      count: 1,
      messageId: item.messageId,
    };
    const controller = new AbortController();
    dmExecutionController = controller;
    dmExecutionJobId = job.id;
    bridgeStatus = 'Checking the signed one-message intent and exact Instagram thread...';
    render();
    try {
      const prepared = await requestExtensionBridge(
        state.bridgePairing,
        'action.dm-live-intent',
        { job },
        { timeoutMs: 15_000 },
      );
      assertCurrentDmExecution(controller, job);
      if (prepared.type === 'action.bridge-error') {
        throw new Error(prepared.payload?.reason || 'extension-rejected-dm-live-intent');
      }
      if (prepared.type !== 'action.dm-live-intent-result') {
        throw new Error('The extension returned an unexpected DM live-intent response.');
      }
      if (prepared.payload?.ready !== true) throw new Error('The exact DM intent was not accepted.');

      bridgeStatus = 'Revalidating the exact thread and sent message before both durable reservations...';
      render();
      const driver = createExtensionDmUnsendDriver(state.bridgePairing, {
        confirmation,
        jobId: job.id,
      });
      const ledger = createIndexedDbDmLedger();
      const result = await executeReviewedDmJob(job, {
        driver,
        ledger,
        settings: state.settings,
        signal: controller.signal,
        async onCheckpoint(checkpointJob) {
          assertCurrentDmExecution(controller, job);
          const savedState = await saveDmJobCheckpoint(checkpointJob);
          assertCurrentDmExecution(controller, job);
          state = savedState;
          render();
        },
      });
      assertCurrentDmExecution(controller, job);
      bridgeStatus = result.status === 'completed'
        ? 'Controlled one-message Unsend completed. The job checkpoint and both ledger results are durable.'
        : `Controlled DM Unsend stopped safely: ${result.stopReason || 'unknown reason'}.`;
      await persist();
    } catch (error) {
      bridgeStatus = controller.signal.aborted
        ? 'Reviewed DM job discarded. No new Unsend will be dispatched; check the durable ledger before retrying because an Unsend already in flight cannot be recalled.'
        : `Stopped: ${error.message}`;
      render();
    } finally {
      if (dmExecutionController === controller) {
        dmExecutionController = null;
        dmExecutionJobId = null;
      }
    }
    return;
  }
  if (action === 'export-reviewed-dm-job') {
    const job = state.dmJobs?.[0];
    if (!job?.reviewConfirmedAt) return;
    downloadJson(`insta-aio-reviewed-dm-job-${Date.now()}.json`, job);
    logActivity('export', `Exported reviewed ${job.mode} DM job.`, {
      jobId: job.id,
      previewDigest: job.previewDigest,
    });
    await persist({ rerender: false });
    return;
  }
  if (action === 'discard-dm-job') {
    const [discarded, ...remaining] = state.dmJobs || [];
    if (discarded?.id === dmExecutionJobId) dmExecutionController?.abort();
    state.dmJobs = remaining;
    if (discarded) {
      logActivity('dm-preview', 'Discarded a reviewed DM preview.', {
        jobId: discarded.id,
      });
    }
    await persist();
    return;
  }
  if (action === 'select-visible-messages') {
    const filtered = filterMessages(state.messages, {
      keyword: messageFilters.keyword,
      onlyMine: messageFilters.onlyMine,
      types: messageFilters.type ? [messageFilters.type] : [],
    });
    const visible = virtualWindow(filtered, {
      scrollTop: messageScrollTop,
      rowHeight: 96,
      viewportHeight: 620,
      overscan: 6,
    }).items.filter((message) => message.isMine);
    state.selectedMessageIds = [
      ...new Set([
        ...state.selectedMessageIds,
        ...visible.map(messageSelectionKey),
      ]),
    ];
    await persist();
    return;
  }
  if (action === 'clear-message-selection') {
    state.selectedMessageIds = [];
    await persist();
    return;
  }
  if (action === 'export-unsend-plan') {
    const plan = createUnsendPlan(state.messages, state.selectedMessageIds);
    downloadJson(`insta-aio-unsend-plan-${Date.now()}.json`, plan);
    logActivity('export', `Exported unsend plan containing ${plan.total} sent messages.`);
    await persist({ rerender: false });
    return;
  }
  if (action === 'export-companion-queue') {
    const queue = state.queue.filter((item) => ['pending', 'ready', 'waiting', 'paused', 'failed'].includes(item.status));
    downloadJson(`insta-aio-manual-queue-${Date.now()}.json`, {
      schemaVersion: 1,
      kind: 'insta-aio-manual-queue',
      exportedAt: new Date().toISOString(),
      queue,
    });
    logActivity('export', `Exported ${queue.length} queue items for the Tampermonkey companion.`);
    await persist({ rerender: false });
    return;
  }
  if (action === 'export-state') {
    downloadJson(`insta-aio-workspace-${Date.now()}.json`, { kind: 'insta-aio-workspace', state });
    logActivity('export', 'Exported full workspace backup.');
    await persist({ rerender: false });
    return;
  }
  if (action === 'export-current-snapshot') {
    const snapshot = activeSnapshot();
    if (snapshot) downloadJson(`insta-aio-snapshot-${Date.now()}.json`, { kind: 'insta-aio-snapshot', snapshot });
    return;
  }
  if (action === 'export-activity') {
    downloadJson(`insta-aio-activity-${Date.now()}.json`, state.activity);
    return;
  }
  if (action === 'create-extension-pairing') {
    try {
      const permissions = document.querySelector('#bridge-action-permission')?.checked
        ? ['read', 'action']
        : ['read'];
      state.bridgePairing = createBridgePairing({
        origin: location.origin,
        permissions,
      }).pairing;
      bridgeStatus = 'Copy the code into the extension popup, then complete the handshake here.';
      logActivity('extension-pairing', 'Created a one-time extension pairing code.', {
        origin: state.bridgePairing.origin,
        permissions,
      });
      await persist();
    } catch (error) {
      bridgeStatus = `Error: ${error.message}`;
      render();
    }
    return;
  }
  if (action === 'complete-extension-pairing') {
    bridgeStatus = 'Waiting for the extension pairing response...';
    render();
    try {
      state.bridgePairing = await completeExtensionPairing(state.bridgePairing);
      bridgeStatus = 'Extension pairing completed and the one-time code was consumed.';
      logActivity('extension-pairing', 'Completed the extension pairing handshake.', {
        origin: state.bridgePairing.origin,
        permissions: state.bridgePairing.permissions,
      });
      await persist();
    } catch (error) {
      bridgeStatus = `Error: ${error.message}`;
      render();
    }
    return;
  }
  if (action === 'ping-extension') {
    bridgeStatus = 'Checking extension connection...';
    render();
    try {
      const response = await requestExtensionBridge(state.bridgePairing, 'bridge.ping');
      bridgeStatus = response.type === 'read.bridge-status'
        ? `Extension ${response.payload.extensionVersion} connected; live account actions are locked by default.`
        : 'Error: The extension returned an unexpected response.';
    } catch (error) {
      bridgeStatus = `Error: ${error.message}`;
    }
    render();
    return;
  }
  if (action === 'revoke-extension-pairing') {
    const origin = state.bridgePairing?.origin;
    state.bridgePairing = null;
    bridgeStatus = 'PWA pairing removed. Revoke the matching origin in the extension popup too.';
    logActivity('extension-pairing', 'Revoked the local extension pairing.', { origin });
    await persist();
    return;
  }
  if (action === 'save-settings') {
    const lines = (value) => value.split(/[\n,]+/).map(normalizeUsername).filter(Boolean);
    state.settings.waitingDays = Math.max(1, Number(document.querySelector('#waiting-days').value || 7));
    state.settings.ownerNames = document.querySelector('#owner-names').value.split(',').map((name) => name.trim()).filter(Boolean);
    state.settings.whitelist = lines(document.querySelector('#whitelist').value);
    state.settings.preexistingFollowing = lines(document.querySelector('#preexisting').value);
    state.settings.protectMutuals = document.querySelector('#protect-mutuals').checked;
    state.settings.dryRun = document.querySelector('#dry-run').checked;
    state.queue = refreshQueue(state.queue, activeSnapshot(), state.settings);
    logActivity('settings', 'Updated local settings and queue protections.');
    await persist();
    return;
  }
  if (action === 'protect-current-following') {
    const snapshot = activeSnapshot();
    state.settings.preexistingFollowing = [...new Set([
      ...state.settings.preexistingFollowing,
      ...(snapshot?.following || []).map((account) => account.username),
    ])].sort();
    logActivity('settings', 'Protected all accounts in the active following snapshot.');
    await persist();
    return;
  }
  if (action === 'reset-workspace') {
    const reviewedState = state;
    const confirmed = await confirmAction({
      title: 'Clear local workspace?',
      message: 'This permanently removes this browser\'s local Insta Toolbox workspace.',
      facts: [
        { label: 'Location', value: 'This browser' },
        { label: 'Data', value: 'Snapshots, queues, messages, pairings, settings, and activity' },
      ],
      confirmLabel: 'Clear local data',
    });
    if (!confirmed) return;
    if (activeView !== 'settings' || state !== reviewedState) {
      bridgeStatus = 'Clear canceled because the workspace changed. Nothing was removed.';
      render();
      return;
    }
    await clearState();
    state = await loadState();
    activeView = 'overview';
    render();
  }
});

app.addEventListener('change', async (event) => {
  const target = event.target;
  if (target.id === 'data-file-input' || target.id === 'data-folder-input') {
    await handleDataImport(target.files);
    target.value = '';
    return;
  }
  if (target.id === 'zip-file-input') {
    const file = target.files?.[0];
    target.value = '';
    if (file) await prepareZipImport(file);
    return;
  }
  if (target.id === 'state-file-input') {
    const file = target.files?.[0];
    if (!file) return;
    try {
      const data = JSON.parse(await file.text());
      if (!data?.state || data.kind !== 'insta-aio-workspace') throw new Error('Not an Insta Toolbox workspace backup.');
      state = migrateState(data.state);
      logActivity('import', 'Restored workspace backup.');
      await persist();
    } catch (error) {
      window.alert(error.message);
    }
    return;
  }
  if (target.id === 'snapshot-select') {
    state.activeSnapshotId = target.value;
    state.queue = refreshQueue(state.queue, activeSnapshot(), state.settings);
    await persist();
    return;
  }
  if (target.id === 'message-type') {
    messageFilters.type = target.value;
    messageScrollTop = 0;
    render();
    return;
  }
  if (target.id === 'only-mine') {
    messageFilters.onlyMine = target.checked;
    messageScrollTop = 0;
    render();
    return;
  }
  if (target.dataset.action === 'toggle-message') {
    const selected = new Set(state.selectedMessageIds);
    if (target.checked) {
      selected.delete(target.dataset.id);
      selected.add(target.dataset.key);
    } else {
      selected.delete(target.dataset.key);
      selected.delete(target.dataset.id);
    }
    state.selectedMessageIds = [...selected];
    await persist();
  }
});

app.addEventListener('input', (event) => {
  if (event.target.id !== 'message-search') return;
  messageFilters.keyword = event.target.value;
  messageScrollTop = 0;
  clearTimeout(globalThis.__instaAioSearchTimer);
  globalThis.__instaAioSearchTimer = setTimeout(render, 120);
});

app.addEventListener('scroll', (event) => {
  const list = event.target.closest?.('[data-virtual-list]');
  if (!list) return;
  const nextTop = list.scrollTop;
  let previousTop;
  let rowHeight;
  if (list.dataset.virtualList === 'queue') {
    previousTop = queueScrollTop;
    queueScrollTop = nextTop;
    rowHeight = 72;
  } else if (list.dataset.virtualList === 'messages') {
    previousTop = messageScrollTop;
    messageScrollTop = nextTop;
    rowHeight = 96;
  } else {
    return;
  }
  if (Math.floor(previousTop / rowHeight) === Math.floor(nextTop / rowHeight)) return;
  if (globalThis.__instaAioVirtualFrame) return;
  globalThis.__instaAioVirtualFrame = requestAnimationFrame(() => {
    globalThis.__instaAioVirtualFrame = null;
    render();
  });
}, true);

if ('serviceWorker' in navigator && location.protocol !== 'file:') {
  navigator.serviceWorker.register('./sw.js', { updateViaCache: 'none' })
    .then((registration) => registration.update())
    .catch(() => {});
}

render();
