          <div class="brand-copy"><strong>Insta Toolbox</strong><span>Local workspace</span></div>
        </div>
        <nav class="nav" aria-label="Primary navigation">
          ${views.map(([id, label]) => `
            <button type="button" data-action="navigate" data-view="${id}" class="${activeView === id ? 'active' : ''}">${escapeHtml(label)}</button>
          `).join('')}
        </nav>
        <div class="sidebar-foot">
          Data remains in this browser unless you export it.<br>
