        </div>
      </aside>
      <main class="main">${content}</main>
      <input id="data-file-input" class="hidden" type="file" accept=".json,application/json" multiple>
      <input id="data-folder-input" class="hidden" type="file" accept=".json,application/json" multiple webkitdirectory>
      <input id="zip-file-input" class="hidden" type="file" accept=".zip,application/zip">
      <input id="state-file-input" class="hidden" type="file" accept=".json,application/json">
    </div>
  `;
}

function renderOverview() {
  const snapshot = activeSnapshot();
  const relationships = classifyRelationships(snapshot || { followers: [], following: [] });
  const diff = activeDiff();
  const queue = getQueueSummary(state.queue);
  const sentMessages = state.messages.filter((message) => message.isMine).length;

  return pageHead(
    'Overview',
    'Compare relationships, review account actions, and plan DM cleanup locally.',
    '<button class="primary" data-action="pick-data-files">Import Instagram data</button>',
  ) + `
    <section class="tool-overview" aria-label="Three-tool workspace">
      <article class="tool-lane">
        <div class="tool-lane-index">01</div>
        <div class="tool-lane-copy"><p class="eyebrow">Read and compare</p><h2>Mutual Checker</h2><p>Compare Followers and Following. Raw captures stay under Advanced.</p><div class="tool-lane-facts"><span><strong>${snapshot?.followers.length || 0}</strong> followers</span><span><strong>${snapshot?.following.length || 0}</strong> following</span><span><strong>${relationships.notFollowingBack.length}</strong> don't follow you back</span></div></div>
        <div class="tool-lane-action"><span>${snapshot ? `Snapshot ${formatDate(snapshot.capturedAt, false)}` : 'Import data to begin'}</span><button data-action="navigate" data-view="relationships">Open checker</button></div>
      </article>
      <article class="tool-lane">
        <div class="tool-lane-index">02</div>
        <div class="tool-lane-copy"><p class="eyebrow">Review profiles</p><h2>Follow / Unfollow</h2><p>Build an exact target list before opening Instagram.</p><div class="tool-lane-facts"><span><strong>${queue.ready || 0}</strong> ready</span><span><strong>${queue.waiting || 0}</strong> waiting</span><span><strong>${diff.lostFollowers.length}</strong> recent unfollows</span></div></div>
        <div class="tool-lane-action"><span>Confirm each action in Instagram</span><button data-action="navigate" data-view="queue">Open queue</button></div>
      </article>
      <article class="tool-lane">
        <div class="tool-lane-index">03</div>
        <div class="tool-lane-copy"><p class="eyebrow">Find sent messages</p><h2>DM Unsend</h2><p>Find messages you sent and create an unsend plan.</p><div class="tool-lane-facts"><span><strong>${state.messages.length}</strong> loaded</span><span><strong>${sentMessages}</strong> sent by you</span><span><strong>${state.selectedMessageIds.length}</strong> selected</span></div></div>
        <div class="tool-lane-action"><span>Confirm removals in Instagram</span><button data-action="navigate" data-view="messages">Open messages</button></div>
      </article>
    </section>

    <section class="workspace-strip" aria-label="Local workspace status">
      <div><span>Snapshots</span><strong>${state.snapshots.length}</strong></div><div><span>Queue records</span><strong>${state.queue.length}</strong></div><div><span>Conversations</span><strong>${conversationSummary(state.messages).length}</strong></div><div><span>Activity records</span><strong>${state.activity.length}</strong></div>
      <p>Your comparisons, queues, conversations, and exports stay on this device. Instagram changes still require a fresh review.</p>
    </section>
