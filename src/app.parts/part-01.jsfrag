function escapeHtml(value) {
  return String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');
}

function formatDate(value, includeTime = true) {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '—';
  return includeTime
    ? date.toLocaleString()
    : date.toLocaleDateString();
}

function formatBytes(value) {
  const bytes = Math.max(0, Number(value) || 0);
  if (bytes < 1024) return `${bytes} B`;
  const units = ['KB', 'MB', 'GB'];
  let size = bytes;
  let unit = -1;
  do {
    size /= 1024;
    unit += 1;
  } while (size >= 1024 && unit < units.length - 1);
  return `${size.toFixed(size >= 10 ? 1 : 2)} ${units[unit]}`;
}

function profileUrl(username) {
  return `https://www.instagram.com/${encodeURIComponent(normalizeUsername(username))}/`;
}

function activeSnapshot() {
  return state.snapshots.find((snapshot) => snapshot.id === state.activeSnapshotId)
    || latestSnapshot(state.snapshots);
}

function activeDiff() {
  const current = activeSnapshot();
  return compareSnapshots(previousSnapshot(state.snapshots, current?.id), current);
}

function logActivity(kind, message, details = {}) {
  state.activity.unshift({
    id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
    timestamp: new Date().toISOString(),
    kind,
    message,
    details,
  });
  state.activity = state.activity.slice(0, 5000);
}

function applyAccountBridgeResult(job, result) {
  let next = job;
  for (const record of result?.results || []) {
    const item = next.items.find((candidate) => candidate.id === record.itemId);
    if (!item) continue;
    const completed = record.status === 'resolved-no-click';
    next = appendActionCheckpoint(next, item.id, {
      status: completed ? 'dry-run-complete' : 'safe-stopped',
      result: completed ? 'resolved-no-click' : null,
      beforeEvidence: record.observation?.evidence || null,
      error: completed ? null : result.stopReason || 'bridge-inspection-failed',
    }, {
      activity: {
        id: `${item.id}:extension-dry-run:${Date.now()}`,
        timestamp: new Date().toISOString(),
        kind: completed ? 'action-dry-run' : 'action-safe-stop',
        message: completed
          ? `Resolved ${item.action} for @${item.username} without clicking.`
          : `Extension inspection stopped before ${item.action} for @${item.username}.`,
        details: { stopReason: result.stopReason || null },
      },
    });
  }
  next.status = result?.status === 'dry-run-complete' ? 'completed' : 'stopped';
  next.control = 'stopped';
  next.stopReason = result?.stopReason || null;
  next.updatedAt = new Date().toISOString();
  return next;
}

function applyDmBridgeResult(job, result) {
  let next = job;
  for (const record of result?.results || []) {
    const item = next.items.find((candidate) => candidate.id === record.itemId);
    if (!item) continue;
    next = appendDmCheckpoint(next, item.id, {
      status: record.status === 'resolved-no-click' ? 'dry-run-complete' : 'safe-stopped',
      result: record.status === 'resolved-no-click' ? 'resolved-no-click' : null,
      resolutionEvidence: record.observation?.evidence || null,
      error: record.status === 'resolved-no-click'
        ? null
        : result.stopReason || 'bridge-inspection-failed',
    }, {
      activity: {
        id: `${item.id}:extension-dry-run:${Date.now()}`,
        timestamp: new Date().toISOString(),
        kind: record.status === 'resolved-no-click' ? 'dm-dry-run' : 'dm-safe-stop',
        message: record.status === 'resolved-no-click'
          ? `Resolved sent message ${item.messageId} without clicking Unsend.`
          : `Extension inspection stopped before message ${item.messageId}.`,
        details: { stopReason: result.stopReason || null },
      },
    });
  }
  next.status = result?.status === 'dry-run-complete' ? 'completed' : 'stopped';
  next.control = 'stopped';
  next.stopReason = result?.stopReason || null;
  next.updatedAt = new Date().toISOString();
  return next;
}

async function persist({ rerender = true } = {}) {
  await saveState(state);
  if (rerender) render();
}

function downloadJson(filename, data) {
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  downloadBlob(filename, blob);
}

function downloadText(filename, text, type = 'text/plain') {
  downloadBlob(filename, new Blob([text], { type }));
}

function downloadBlob(filename, blob) {
  const url = URL.createObjectURL(blob);
  const anchor = document.createElement('a');
  anchor.href = url;
  anchor.download = filename;
  document.body.append(anchor);
  anchor.click();
  anchor.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function csvEscape(value) {
  const text = String(value ?? '');
  return /[",\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text;
}

function accountsToCsv(accounts) {
  const rows = [['username', 'id', 'displayName', 'profileUrl', 'source']];
  for (const account of accounts || []) {
    rows.push([
      account.username,
      account.id || '',
      account.displayName || '',
      account.profileUrl || profileUrl(account.username),
      account.source || '',
    ]);
  }
  return rows.map((row) => row.map(csvEscape).join(',')).join('\n');
}

function pageHead(title, description, actions = '') {
  return `
    <header class="page-head">
      <div>
        <h1 data-page-heading tabindex="-1">${escapeHtml(title)}</h1>
        <p>${escapeHtml(description)}</p>
      </div>
      ${actions ? `<div class="toolbar">${actions}</div>` : ''}
    </header>
  `;
}

function metric(label, value, detail = '') {
  return `
    <article class="metric">
      <div class="label">${escapeHtml(label)}</div>
      <div class="value">${escapeHtml(value)}</div>
      ${detail ? `<div class="detail">${escapeHtml(detail)}</div>` : ''}
    </article>
  `;
}

function renderShell(content) {
